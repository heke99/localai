# Tracked durable GPUHub production model profile.
# The llama.cpp total context is split evenly across parallel slots.
DIV3RSA_GPUHUB_PRODUCTION_PARALLEL=8
DIV3RSA_GPUHUB_PRODUCTION_TOTAL_CONTEXT=262144
DIV3RSA_GPUHUB_PRODUCTION_CONTEXT_PER_SLOT=32768
# GPUHub owns 6007 for TensorBoard. LocalAI embeddings stay loopback-only on a
# dedicated high port and must never compete with provider-managed services.
DIV3RSA_GPUHUB_PRODUCTION_EMBEDDING_PORT=16007
# Structured OpenAI-compatible tool calls require the Jinja chat parser. Keep it
# explicit even if a future llama.cpp build changes its default.
DIV3RSA_GPUHUB_PRODUCTION_JINJA=true
# Production benchmark 2026-08-28: ngram-mod preserved the 8/8 agent gate and
# materially accelerated repeated reasoning paths without a second draft model.
DIV3RSA_GPUHUB_PRODUCTION_SPEC_TYPE=ngram-mod
