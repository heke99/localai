[Unit]
Description=DIV3RSA isolated Linux security executor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=div3rsa-security
Group=div3rsa-security
WorkingDirectory=/opt/div3rsa/localai
EnvironmentFile=/etc/div3rsa/security-executor.env
ExecStart=/opt/div3rsa/localai/infra/runtime/start-security-executor.sh
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictNamespaces=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/log/div3rsa

[Install]
WantedBy=multi-user.target
