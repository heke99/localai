# Secrets are provisioned outside git.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DIV3RSA_INFERENCE_API_KEY=

# CPU control plane never hosts or registers inference locally.
DIV3RSA_INFERENCE_ROUTING_MODE=registry
DIV3RSA_MODEL_PARALLEL=8
DIV3RSA_WORKER_CONCURRENCY=8
DIV3RSA_RUNTIME_ROLE=control-plane

# Existing production Agent Kernel canary gates.
DIV3RSA_AGENT_KERNEL_V2_ENABLED=1
DIV3RSA_AGENT_KERNEL_V2_MODE=active
DIV3RSA_AGENT_KERNEL_V2_ACTIVE_CANARY_BPS=25
DIV3RSA_AGENT_KERNEL_V2_VERIFICATION_REQUIRED=1
DIV3RSA_DYNAMIC_TOOL_DISCOVERY_ENABLED=1
DIV3RSA_CHECKPOINT_REWIND_ENABLED=1
DIV3RSA_VERIFIED_MEMORY_ENABLED=1
DIV3RSA_VERIFIED_LEARNING_ENABLED=1
DIV3RSA_TRAINING_ELIGIBILITY_ENABLED=0

DIV3RSA_INTEGRATION_GATEWAY_URL=https://system.div3rsa.com/api/internal/integrations/execute
DIV3RSA_SEARCH_BASE_URL=http://127.0.0.1:8890
DIV3RSA_REPOSITORY_ROOT=/opt/div3rsa/localai/app
