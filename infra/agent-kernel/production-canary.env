# Source-controlled production canary profile. This file contains no secrets.
# Promotion workflow applies it only after an isolated 100% V2 eval passes.
DIV3RSA_AGENT_KERNEL_V2_ENABLED=1
DIV3RSA_AGENT_KERNEL_V2_MODE=active
DIV3RSA_AGENT_KERNEL_V2_ACTIVE_CANARY_BPS=25
DIV3RSA_AGENT_KERNEL_V2_MAX_SUBAGENTS=4
DIV3RSA_AGENT_KERNEL_V2_MAX_PARALLEL_SUBAGENTS=2
DIV3RSA_AGENT_KERNEL_V2_VERIFICATION_REQUIRED=1
DIV3RSA_AGENT_KERNEL_V2_ACTIVE_TIMEOUT_MS=4000
DIV3RSA_AGENT_KERNEL_V2_ACTIVE_MAX_OUTPUT_TOKENS=384
DIV3RSA_DYNAMIC_TOOL_DISCOVERY_ENABLED=1
DIV3RSA_DYNAMIC_TOOL_MAX_IMMEDIATE=8
DIV3RSA_DYNAMIC_TOOL_MAX_DISCOVERED=16
DIV3RSA_CHECKPOINT_REWIND_ENABLED=1
DIV3RSA_CHECKPOINT_MAX_REWINDS=2
DIV3RSA_VERIFIED_MEMORY_ENABLED=1
DIV3RSA_VERIFIED_LEARNING_ENABLED=1
# Training eligibility stays off until a separately frozen/evaluated dataset pipeline is promoted.
DIV3RSA_TRAINING_ELIGIBILITY_ENABLED=0
