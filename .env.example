APP_URL=https://system.div3rsa.com
NEXT_PUBLIC_SUPABASE_URL=https://eaebyxwedmwhctoqrvji.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_URL=https://eaebyxwedmwhctoqrvji.supabase.co
MODEL_GATEWAY_INTERNAL_TOKEN=

# Provider-neutral model runtime contract. The agent worker normally runs beside
# llama.cpp and therefore talks to localhost regardless of GPU vendor or Pod ID.
# Keep all inference credentials server-only; never expose them through NEXT_PUBLIC_*.
DIV3RSA_INFERENCE_BASE_URL=http://127.0.0.1:8080/v1
DIV3RSA_INFERENCE_API_KEY=
# Legacy compatibility only. Existing deployments may keep these during rollout;
# new deployments should use DIV3RSA_INFERENCE_*.
QWEN_INFERENCE_BASE_URL=
QWEN_INFERENCE_API_KEY=
DIV3RSA_WORKER_ID=agent-worker-1
DIV3RSA_REPOSITORY_ROOT=/app
DIV3RSA_INTEGRATION_GATEWAY_URL=https://system.div3rsa.com/api/internal/integrations/execute
DIV3RSA_MODEL_STARTUP_TIMEOUT_MS=900000
DIV3RSA_MODEL_STARTUP_POLL_MS=5000

# Provider-neutral Runtime Manager in the web control plane. Model aliases such as
# general-prod/code-prod are stable; physical runtime IDs and endpoints are stored
# in the service-role-only Supabase runtime registry and can change at any time.
DIV3RSA_RUNTIME_PROFILE=large_96gb
DIV3RSA_RUNTIME_PROVIDER_ORDER=runpod,generic-openai
DIV3RSA_RUNTIME_ROUTE_CACHE_MS=15000

# Optional generic OpenAI-compatible provider. This is the zero-code plug-in path
# for any externally managed GPU/vendor exposing a stable OpenAI-compatible /v1.
# Set GENERIC_RUNTIME_PROVIDER_KEY to a vendor key (or leave generic-openai), then
# change DIV3RSA_RUNTIME_PROVIDER_ORDER to prefer it. Credentials never enter DB.
GENERIC_RUNTIME_PROVIDER_KEY=generic-openai
GENERIC_RUNTIME_BASE_URL=
GENERIC_RUNTIME_API_KEY=
GENERIC_RUNTIME_HEALTH_URL=
GENERIC_RUNTIME_EXTERNAL_ID=
GENERIC_RUNTIME_REGION=
GENERIC_RUNTIME_GPU_TYPE=
GENERIC_RUNTIME_GPU_COUNT=
GENERIC_RUNTIME_VRAM_GB=
GENERIC_RUNTIME_HEALTH_TIMEOUT_MS=3000

# RunPod adapter. RUNPOD_POD_ID is only the primary/bootstrap candidate; it is no
# longer the permanent runtime identity. The Runtime Manager may register/reuse a
# replacement Pod and route the same model alias to it transparently.
RUNPOD_API_KEY=
RUNPOD_POD_ID=b8kxzn86fvrejm
RUNPOD_RUNTIME_HEALTH_URL=https://b8kxzn86fvrejm-8080.proxy.runpod.net/health
RUNPOD_RUNTIME_HEALTH_PORT=8080
RUNPOD_RUNTIME_HEALTH_PATH=/health
RUNPOD_RESTART_UNHEALTHY=1
RUNPOD_API_TIMEOUT_MS=5000
RUNPOD_RUNTIME_HEALTH_TIMEOUT_MS=2000
RUNPOD_RUNTIME_RUNNING_CACHE_MS=15000
RUNPOD_RUNTIME_RESTART_GRACE_MS=300000
RUNPOD_START_ATTEMPTS=3
RUNPOD_START_RETRY_BASE_MS=500
# Optional override. REST start is primary; GraphQL podResume is the control-plane fallback.
RUNPOD_GRAPHQL_API_URL=https://api.runpod.io/graphql

# Managed RunPod failover. If the original Pod cannot resume, the web control
# plane can reuse an existing replacement or create a new Secure Cloud Pod on
# the same Network Volume. Set the volume ID explicitly for recovery even if
# the original Pod is later terminated/deleted from the RunPod account.
RUNPOD_AUTO_REPLACE_UNAVAILABLE=1
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_RUNTIME_FAMILY_NAME=div3rsa-localai-production
# Optional: prefer a dedicated RunPod Pod template for replacement Pods.
RUNPOD_FAILOVER_TEMPLATE_ID=
# Current production target is 96 GB total VRAM: two 48 GB GPUs. The runtime
# keeps the source GPU count by default and may choose among these equivalent
# 48 GB GPU families according to availability in the Network Volume datacenter.
RUNPOD_FAILOVER_GPU_COUNT=2
RUNPOD_FAILOVER_GPU_TYPE_IDS=NVIDIA L40S,NVIDIA L40,NVIDIA RTX A6000,NVIDIA A40,NVIDIA RTX 6000 Ada Generation

# Provider-independent runtime bootstrap paths. A future provider adapter should
# launch the same boot contract: obtain the repo, model artifact, start llama.cpp,
# then start the agent worker. Provider-specific compute remains disposable.
DIV3RSA_REPO_DIR=/workspace/localai-app
DIV3RSA_LLAMA_SERVER_BIN=/workspace/localai/llama.cpp/build/bin/llama-server
DIV3RSA_MODEL_PATH=/workspace/localai/models/qwen38-v3-q8/Qwen3.8-27B-OBLITERATED-Q8_0.gguf
DIV3RSA_MODEL_RUNTIME_ALIAS=localai-qwen38-v3-q8
DIV3RSA_MODEL_PORT=8080
DIV3RSA_MODEL_CONTEXT_SIZE=32768
DIV3RSA_MODEL_BATCH_SIZE=2048
DIV3RSA_MODEL_PARALLEL=4
DIV3RSA_MODEL_BOOT_TIMEOUT_SECONDS=900
DIV3RSA_RUNPOD_LOG_DIR=/workspace/logs/div3rsa
DIV3RSA_START_RUNPOD_BASE_SERVICES=1
DIV3RSA_INSTALL_NODE_DEPS_ON_BOOT=0

# Sync the persistent checkout to the exact fetched main commit before the worker
# starts. Leave strict=0 until non-interactive Git credentials are verified on
# the runtime, then use strict=1 to fail closed rather than boot stale code.
DIV3RSA_GIT_SYNC_ON_BOOT=1
DIV3RSA_GIT_SYNC_STRICT=0
DIV3RSA_GIT_REMOTE=origin
DIV3RSA_GIT_BRANCH=main

# Stripe Billing. Use a server-side restricted/secret key only; never expose it as NEXT_PUBLIC_*.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=price_1U7uhlDYqE0xrJ8noBNnu8Nl

GITHUB_INTEGRATION_APP_ID=
GITHUB_INTEGRATION_APP_SLUG=
GITHUB_INTEGRATION_CLIENT_ID=
GITHUB_INTEGRATION_CLIENT_SECRET=
GITHUB_INTEGRATION_PRIVATE_KEY=
GITHUB_INTEGRATION_WEBHOOK_SECRET=
GITHUB_INTEGRATION_CAPABILITIES=

SUPABASE_INTEGRATION_CLIENT_ID=
SUPABASE_INTEGRATION_CLIENT_SECRET=
SUPABASE_INTEGRATION_CAPABILITIES=

# Vercel External Integration used for project/team authorization.
# Redirect URL in Vercel must be:
# https://system.div3rsa.com/api/integrations/vercel/callback
# Connect begins at https://vercel.com/integrations/<slug>/new, where the user
# chooses the Vercel account/team and projects that DIV3RSA may access.
VERCEL_INTEGRATION_SLUG=
VERCEL_INTEGRATION_CLIENT_ID=
VERCEL_INTEGRATION_CLIENT_SECRET=
# Optional capability override. Defaults are limited to project discovery,
# deployments read/create/rollback and runtime-log read.
VERCEL_INTEGRATION_CAPABILITIES=
# Optional; defaults to https://api.vercel.com/v2/oauth/access_token
VERCEL_INTEGRATION_TOKEN_URL=